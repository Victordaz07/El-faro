{
  "name": "faro-tormenta",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "sim": "esbuild tests/sim.ts --bundle --platform=node --outfile=tests/.sim.cjs --log-level=warning && node tests/.sim.cjs",
    "android:sync": "npm run build && npx cap sync android",
    "android:open": "npx cap open android",
    "test": "esbuild tests/pearls.ts --bundle --platform=node --outfile=tests/.pearls.cjs --log-level=warning && node tests/.pearls.cjs"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.3",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vite": "^8.4.0",
    "vite-plugin-singlefile": "^2.3.4"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.3",
    "@capacitor/core": "^8.6.3"
  }
}
