{
  "name": "faro-tormenta",
  "version": "0.10.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "sim": "esbuild tests/sim.ts --bundle --platform=node --outfile=tests/.sim.cjs --log-level=warning && node tests/.sim.cjs",
    "android:sync": "npm run build && npx cap sync android",
    "android:open": "npx cap open android",
    "sim:zonas": "esbuild tests/zonas.ts --bundle --platform=node --outfile=tests/.zonas.cjs --log-level=warning && node tests/.zonas.cjs",
    "sim:tune": "esbuild tests/tune.ts --bundle --platform=node --outfile=tests/.tune.cjs --log-level=warning && node tests/.tune.cjs",
    "sim:camp": "esbuild tests/campaign.ts --bundle --platform=node --outfile=tests/.camp.cjs --log-level=warning && node tests/.camp.cjs",
    "sim:modes": "esbuild tests/modes.ts --bundle --platform=node --outfile=tests/.modes.cjs --log-level=warning && node tests/.modes.cjs",
    "test": "esbuild tests/pearls.ts --bundle --platform=node --outfile=tests/.pearls.cjs --log-level=warning && node tests/.pearls.cjs && esbuild tests/i18n.ts --bundle --platform=node --outfile=tests/.i18n.cjs --log-level=warning && node tests/.i18n.cjs && esbuild tests/smoke.ts --bundle --platform=node --outfile=tests/.smoke.cjs --log-level=warning && node tests/.smoke.cjs"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.3",
    "esbuild": "^0.28.2",
    "three": "^0.170.0",
    "typescript": "^7.0.2",
    "vite": "^8.4.0",
    "vite-plugin-singlefile": "^2.3.4"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.3",
    "@capacitor/core": "^8.6.3",
    "@fontsource/lilita-one": "^5.3.0",
    "@fontsource/nunito": "^5.3.0"
  }
}
